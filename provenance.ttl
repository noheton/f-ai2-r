    rdfs:label "human-read"@en ;
    rdfs:comment "A HUMAN has read the source in full. Top of the ladder; consolidates the former lit-read rung. Human-only: an AI agent must never grant this rung."@en ;
    skos:altLabel "lit-read"@en ;
    aiprov:ladderPosition 6 .

verif:needs-research a aiprov:VerificationState ;
    rdfs:label "needs research"@en ;
    rdfs:comment "A check was attempted or demanded and did not succeed (e.g. DOI did not resolve). Must not be cited or relied upon until re-verified."@en ;
    aiprov:ladderPosition 1 .

verif:source-vendored a aiprov:VerificationState ;
    rdfs:label "source vendored"@en ;
    rdfs:comment "A copy of the source is preserved inside the repository, immune to link rot; the vendored bytes are what any later audit reads."@en ;
    aiprov:ladderPosition 4 .

verif:unverified a aiprov:VerificationState ;
    rdfs:label "unverified"@en ;
    rdfs:comment "Recorded, nothing checked yet by anyone. Default state at creation."@en ;
    aiprov:ladderPosition 0 .

aiprov:AIContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:HumanContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:MetaContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:Prompt a owl:Class ;
    rdfs:comment "A versioned prompt file. Bind to activities via prov:qualifiedAssociation/prov:hadPlan or dcterms:source."@en ;
    rdfs:subClassOf prov:Plan .

aiprov:Repair a owl:Class ;
    rdfs:comment "Fixes a structural defect in the graph itself (e.g. backfilled parent)."@en ;
    rdfs:subClassOf prov:Activity .

aiprov:Transcript a owl:Class ;
    rdfs:comment "Preserved conversation record; bound to activities via aiprov:transcript."@en ;
    rdfs:subClassOf prov:Entity .

aiprov:affiliation a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:cacheReadTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:cacheWriteTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:contentHash a owl:DatatypeProperty ;
    rdfs:comment "sha256 of the artefact bytes at generation time."@en ;
    rdfs:range xsd:string .

aiprov:contextWindow a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:contradicts a owl:ObjectProperty ;
    rdfs:domain aiprov:Claim ;
    rdfs:range aiprov:Claim .

aiprov:cost a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:costCurrency a owl:DatatypeProperty ;
    rdfs:comment "ISO 4217, e.g. EUR, USD."@en ;
    rdfs:range xsd:string .

aiprov:doi a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI .

aiprov:endpoint a owl:DatatypeProperty ;
    rdfs:comment "API endpoint or gateway URL through which the model was reached."@en ;
    rdfs:range xsd:anyURI .

aiprov:energyWh a owl:DatatypeProperty ;
    rdfs:comment "Optional energy estimate for the inference, in watt-hours."@en ;
    rdfs:range xsd:decimal .

aiprov:filePath a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:gitCommit a owl:DatatypeProperty ;
    rdfs:comment "Commit hash binding the entity to repository state."@en ;
    rdfs:range xsd:string .

aiprov:inputTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:knowledgeCutoff a owl:DatatypeProperty ;
    rdfs:range xsd:date .

aiprov:ladderPosition a owl:DatatypeProperty ;
    rdfs:comment "Total order of the ladder; promotions must strictly increase this value."@en ;
    rdfs:domain aiprov:VerificationState ;
    rdfs:range xsd:integer .

aiprov:maxTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:model a owl:DatatypeProperty ;
    rdfs:comment "Model identifier, e.g. claude-opus-5."@en ;
    rdfs:domain aiprov:AIAgent ;
    rdfs:range xsd:string .

aiprov:modelVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:orcid a owl:DatatypeProperty ;
    rdfs:domain aiprov:HumanAgent ;
    rdfs:range xsd:anyURI .

aiprov:outputTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:promptHash a owl:DatatypeProperty ;
    rdfs:comment "Content hash (e.g. sha256) of the exact prompt text used."@en ;
    rdfs:range xsd:string .

aiprov:provider a owl:DatatypeProperty ;
    rdfs:comment "e.g. Anthropic, local/llama.cpp, gateway name."@en ;
    rdfs:range xsd:string .

aiprov:reasoningTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:repairs a owl:ObjectProperty ;
    rdfs:comment "A Repair activity amends generation metadata of a claim without invalidating its content."@en .

aiprov:requestId a owl:DatatypeProperty ;
    rdfs:comment "Provider request ID for a single inference call."@en ;
    rdfs:range xsd:string .

aiprov:seed a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:sessionId a owl:DatatypeProperty ;
    rdfs:comment "Client session identifier (e.g. Claude Code session UUID)."@en ;
    rdfs:range xsd:string .

aiprov:stopReason a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:systemPromptRef a owl:ObjectProperty ;
    rdfs:comment "Links an activity to the system-prompt entity in force."@en .

aiprov:temperature a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:toolCalls a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:topP a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:totalTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:transcript a owl:ObjectProperty ;
    rdfs:comment "Links the activity to a preserved conversation transcript entity."@en .

aiprov:turnCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:usedTool a owl:DatatypeProperty ;
    rdfs:comment "Repeatable: one value per distinct tool invoked (web_search, bash, ...)."@en ;
    rdfs:range xsd:string .

aiprov:verificationState a owl:ObjectProperty ;
    rdfs:comment "Current rung of a claim or source on the verification ladder. Exactly one value; transitions are recorded as AuditPass activities so the history stays in the graph."@en ;
    rdfs:domain aiprov:Claim ;
    rdfs:range aiprov:VerificationState .

