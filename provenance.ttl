verif:human-confirmed a aiprov:VerificationState ;
    rdfs:label "human-confirmed"@en ;
    rdfs:comment "A HUMAN checked that the source supports the claim (targeted spot-check, not necessarily a full read). Human-only: an AI agent must never grant this rung."@en ;
    aiprov:ladderPosition 5 .

