<https://noheton.org/f-ai2-r/prov/activity/s09-incident> a aiprov:AuditPass ;
    rdfs:label "Incident record (honest self-report): while creating paper-template stubs, a persisted working directory caused the agent to overwrite paper/sections/01-introduction.tex and 02-background.tex with generic stubs and create four stray stub files. Detected immediately via file-change notices and git status; both files restored with git checkout from commit 75d21bd; stray files deleted; nothing lost or pushed. Kept in the graph as evidence for the repository-is-the-process discussion (paper section 6.2)"@en ;
    prov:endedAtTime "2026-07-24T18:45:54.248700+00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith agent:claude-code ;
    aiprov:sessionId "session_01VKCLhUZ6NZ7suGGsJp2mA4"^^xsd:string ;
    aiprov:usedTool "bash",
        "git" .

